{
  "project": "Drift-Sense Navigation Error Recovery",
  "version": "1.0.0",
  "dataset": {
    "image_size_px": [1000, 1000],
    "nominal_scale": 10.0,
    "architectures": ["FinFET", "DRAM"],
    "sem_degradations": {
      "edge_bloom": 0.25,
      "blur_sigma": 0.5,
      "shot_dose": 200.0,
      "gaussian_std": 5.0,
      "charging_strength": 10.0,
      "contrast": 1.0,
      "gamma": 1.0
    }
  },
  "matcher": {
    "scale_range": [8.5, 11.5],
    "scale_steps": 7,
    "rotation_range": [-2.5, 2.5],
    "rotation_steps": 5,
    "tie_breaker_rule": "closest_to_search_center",
    "subpixel_refinement": "2d_parabolic_quadratic"
  }
}
